# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Test-only value for the cron token used by MessengerConsumeControllerTest.
# Matches the constant in tests/Controller/MessengerConsumeControllerTest.php.
# Must NEVER be set in dev or prod; .env.test is loaded only when APP_ENV=test.
MESSENGER_CRON_TOKEN=test-cron-token-please-rotate

# Salesforce test defaults. The values here are deliberately invalid so
# any code path that accidentally hits the real Salesforce API during
# a test run will surface as a SalesforceAuthException instead of
# silently sending a request to a real org. Tests that exercise the
# Salesforce stack must mock SalesforceAuthenticator / SalesforceClient.
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_CLIENT_ID=test-salesforce-client-id
SALESFORCE_CLIENT_SECRET=test-salesforce-client-secret
SALESFORCE_API_VERSION=v60.0
