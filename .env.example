# =============================================================
# CV Management — environment template
#
# Copy this file to `.env` (or `.env.local`) and fill in your
# own values. NEVER commit the populated `.env`.
#
#   cp .env.example .env
#
# Categories below:
#   1. Symfony core
#   2. Database (PostgreSQL)
#   3. Public URLs (one-domain deployment)
#   4. CORS
#   5. Trusted proxies / hosts
#   6. Mailer (Brevo / null transport)
#   7. Messenger
#   8. OAuth (Google + Facebook via HWI bundle)
#   9. Cloudinary (image uploads)
#  10. Admin bootstrap (one-shot)
#  11. Frontend (Vite)
#  12. Local docker-compose host port overrides
# =============================================================


# ---------------- 1. Symfony core ----------------
# `prod` for production (Render), `dev` for local development.
APP_ENV=dev
APP_DEBUG=1
# Generate with: openssl rand -hex 32
APP_SECRET=change_me


# ---------------- 2. Database (PostgreSQL) ----------------
# Local docker-compose service is "postgres", user "app", password
# "password". For Render, substitute the Internal Connection String
# provided by your Render PostgreSQL instance and set serverVersion to
# the actual version of that database.
DATABASE_URL="postgresql://app:password@postgres:5432/symfony?serverVersion=18&charset=utf8"


# ---------------- 3. Public URLs (one-domain) ----------------
# The single public origin served by Nginx. In production this is
# the Render domain. Used by Symfony URL generation in CLI commands
# and by the email-verification flow to redirect back to the SPA.
DEFAULT_URI=http://localhost:8080
FRONTEND_URL=http://localhost:5174


# ---------------- 4. CORS ----------------
# Single allowed Origin for CORS preflight. Should match FRONTEND_URL
# (or the React origin). On Render this becomes the Render domain.
CORS_ALLOW_ORIGIN=http://localhost:5174


# ---------------- 5. Trusted proxies / hosts ----------------
# Symfony reads SYMFONY_TRUSTED_PROXIES / SYMFONY_TRUSTED_HOSTS when
# running behind a reverse proxy (Render's edge proxy).
# On Render, REMOTE_ADDR and ^.*$ are the correct values.
SYMFONY_TRUSTED_PROXIES=REMOTE_ADDR
SYMFONY_TRUSTED_HOSTS=^(.*)$


# ---------------- 6. Mailer ----------------
# `null://null` disables sending (useful for local dev).
# For real email set:
#   MAILER_DSN=brevo+api://YOUR_BREVO_API_KEY@default
MAILER_DSN=null://null
MAILER_FROM_ADDRESS=noreply@example.com
MAILER_FROM_NAME="CV Management"


# ---------------- 7. Messenger ----------------
# Doctrine transport uses the application's own database. The default
# below is sufficient for both local and production.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0


# ---------------- 8. OAuth (HWI bundle) ----------------
# Google: from Google Cloud Console → APIs & Services → Credentials.
# Registered redirect URI must be:
#   https://<your-domain>/login/check-google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook: from Facebook Developers → App → Settings → Basic.
# Registered redirect URI must be:
#   https://<your-domain>/login/check-facebook
FB_ID=
FB_SECRET=


# ---------------- 9. Cloudinary ----------------
# Account credentials from the Cloudinary Dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional preset for unsigned uploads; usually left empty.
CLOUDINARY_UPLOAD_PRESET=


# ---------------- 10. Admin bootstrap (ONE-SHOT) ----------------
# Set BOTH on the first deploy to create / promote the initial
# administrator via `php bin/console app:create-admin`. After the
# bootstrap succeeds, REMOVE these from the Render dashboard.
# The entrypoint unsets them in-process immediately after use.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ---------------- 10b. Messenger cron (REQUIRED on Render) ----------------
# Shared secret used by the external cron.org scheduler to authenticate
# POST requests to https://<render-domain>/messenger/consume, which drains
# the Symfony Messenger `async` queue (Doctrine transport).
#
# Generate: openssl rand -hex 32
# cron.org config:
#   Method:  POST
#   URL:     https://<render-domain>/messenger/consume
#   Header:  Authorization: Bearer <value-of-this-env-var>
#   Sched:   every 1–5 minutes (free tier: 1-minute minimum)
#
# If unset, the endpoint will reject ALL requests with HTTP 401 — it
# never lets traffic through unauthenticated.
MESSENGER_CRON_TOKEN=


# ---------------- 11. Frontend (Vite) ----------------
# Leave empty for same-origin deployment on Render — requests will be
# resolved relative to the current origin. Set to e.g. `https://api.example.com`
# ONLY if you deliberately run the SPA and API on different hosts.
VITE_API_BASE=


# ---------------- 12. Local docker-compose host port overrides ----------------
# These are read by docker-compose.yaml ONLY. They control which host
# port maps to the in-container port. Do NOT set these in production.
APP_PORT=8080
FORWARD_DB_PORT=5432
VITE_PORT=5173
# The values below feed the `postgres` service's container env and
# are ALSO referenced from the local DATABASE_URL above. Keep them
# aligned with the credentials used in DATABASE_URL.
DB_USERNAME=app
DB_PASSWORD=password
DB_DATABASE=symfony